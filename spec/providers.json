{
  "$schema": "./providers.schema.json",
  "spec_version": 1,
  "description": "Provider rules shared by the Python package (src/freemodel_sync) and the dsh plugin (plugins/dsh-freemodel). Change a rule here, add a case under spec/conformance/, and both implementations must pass it.",
  "failureKinds": ["model", "transient", "account", "capacity", "quota"],
  "capabilities": {
    "description": "Capability flags shared by both implementations. null means the catalogue does not say (unknown); it is never treated as false.",
    "fields": ["tools", "vision", "reasoning"],
    "sources": ["catalog", "config", "probe", "manual", "unknown"]
  },
  "quota": {
    "description": "Generic quota vocabulary shared by both implementations. A window with no fixed length (total, beta) has no periodSeconds.",
    "units": ["requests", "tokens", "credits", "unknown"],
    "periods": ["rolling_5h", "week", "day", "total", "beta", "unknown"],
    "periodSeconds": { "rolling_5h": 18000, "week": 604800, "day": 86400 },
    "sources": ["api", "headers", "manual", "none"],
    "scopes": ["account", "model"]
  },
  "defaultErrorMap": {
    "description": "Conservative default for OpenAI-compatible providers without their own rules.",
    "preStream": [
      { "status": [401, 402, 403, 429], "kind": "account" },
      { "status": [408], "kind": "transient" },
      { "statusMin": 500, "kind": "transient" }
    ],
    "default": "model"
  },
  "streamError": {
    "description": "Errors inside the SSE stream, after HTTP 200 (same algorithm for every provider): code 401/402 -> account; 403 -> the provider's preStream rules; other 4xx except 408/429 -> transient if the preStream rules say transient, else model; anything else (no code, 408, 429, 5xx) -> transient. finish_reason 'error' -> transient, 'content_filter' -> model.",
    "accountCodes": [401, 402],
    "delegateCodes": [403],
    "transientCodes": [408, 429]
  },
  "providers": {
    "openrouter": {
      "displayName": "OpenRouter (:free models)",
      "tier": 1,
      "authKind": "api_key",
      "baseURL": "https://openrouter.ai/api/v1",
      "modelsPath": "/models",
      "modelsNeedKey": false,
      "apiKeyEnv": "OPENROUTER_API_KEY",
      "freeRule": {
        "kind": "suffix-free",
        "description": "Id ends with ':free', every price is 0 (also pricing.overrides), not an openrouter/* meta-router, text in and text out.",
        "suffix": ":free",
        "pricingZero": true,
        "excludePrefixes": ["openrouter/"]
      },
      "catalogFields": {
        "contextLength": ["context_length", "top_provider.context_length"],
        "toolsWhen": { "field": "supported_parameters", "contains": "tools" },
        "expirationDate": "expiration_date"
      },
      "capabilities": {
        "tools": { "where": "supported_parameters", "contains": "tools" },
        "vision": { "where": "architecture.input_modalities", "contains": "image" },
        "reasoning": { "where": "supported_parameters", "contains": "reasoning" },
        "source": "catalog"
      },
      "probe": { "path": "/chat/completions", "maxTokensParam": "max_tokens", "defaultMaxTokens": 16, "prompt": "Reply with OK." },
      "errorMap": {
        "preStream": [
          { "status": [401, 402], "kind": "account" },
          { "status": [403], "when": [{ "truthy": "metadata.limit_source" }], "kind": "account" },
          {
            "status": [403],
            "when": [
              { "in": "metadata.error_type", "values": ["content_policy_violation", "refusal"] },
              { "truthy": "metadata.failed_routing_step" },
              { "truthy": "metadata.routing_funnel" },
              { "truthy": "metadata.reasons" },
              { "truthy": "metadata.flagged_input" },
              { "truthy": "metadata.model_slug" }
            ],
            "kind": "model"
          },
          { "status": [403], "kind": "account" },
          {
            "status": [429],
            "when": [{ "truthy": "metadata.provider_name" }, { "notNull": "metadata.provider_code" }],
            "kind": "transient"
          },
          { "status": [429], "kind": "account" },
          { "status": [408], "kind": "transient" },
          { "statusMin": 500, "kind": "transient" }
        ],
        "default": "model"
      },
      "rateLimitHeaders": {
        "retryAfter": "retry-after",
        "reset": "x-ratelimit-reset",
        "resetFormat": "epoch-or-relative",
        "remaining": "x-ratelimit-remaining"
      },
      "keyPatterns": [{ "prefix": "sk-or-", "regex": "\\bsk-or-v1-[a-f0-9]{64}\\b" }],
      "docs": [
        { "url": "https://openrouter.ai/docs/api/api-reference/models/get-models", "checked": "2026-10-22" },
        { "url": "https://openrouter.ai/docs/api-reference/limits", "checked": "2026-10-22" }
      ]
    },
    "groq": {
      "displayName": "Groq (Free plan)",
      "tier": 1,
      "authKind": "api_key",
      "baseURL": "https://api.groq.com/openai/v1",
      "modelsPath": "/models",
      "modelsNeedKey": true,
      "apiKeyEnv": "GROQ_API_KEY",
      "freeRule": {
        "kind": "plan-confirm",
        "description": "Free only on a Free-plan organization, which the API cannot report: nothing is listed or probed until the user confirms the plan.",
        "option": "plan",
        "value": "free"
      },
      "catalogFields": {
        "contextLength": ["context_window"],
        "toolsWhen": null,
        "activeField": "active"
      },
      "capabilities": {
        "tools": null,
        "vision": null,
        "reasoning": null,
        "source": "unknown"
      },
      "probe": { "path": "/chat/completions", "maxTokensParam": "max_completion_tokens", "defaultMaxTokens": 16, "prompt": "Reply with OK." },
      "errorMap": {
        "preStream": [
          { "status": [401, 403, 429], "kind": "account" },
          { "status": [408, 498], "kind": "transient" },
          { "statusMin": 500, "kind": "transient" }
        ],
        "default": "model"
      },
      "rateLimitHeaders": {
        "retryAfter": "retry-after",
        "reset": "x-ratelimit-reset-requests",
        "resetFormat": "duration",
        "remaining": "x-ratelimit-remaining-requests"
      },
      "keyPatterns": [{ "prefix": "gsk_", "regex": "\\bgsk_[A-Za-z0-9]{40,}\\b" }],
      "docs": [
        { "url": "https://console.groq.com/docs/models", "checked": "2026-10-22" },
        { "url": "https://console.groq.com/docs/rate-limits", "checked": "2026-10-22" },
        { "url": "https://console.groq.com/docs/errors", "checked": "2026-10-22" },
        { "url": "https://console.groq.com/docs/billing-faqs", "checked": "2026-10-22" }
      ]
    },
    "sensenova": {
      "displayName": "SenseNova Token Plan",
      "tier": 1,
      "authKind": "api_key",
      "baseURL": "https://token.sensenova.cn/v1",
      "modelsPath": "/models",
      "modelsNeedKey": true,
      "apiKeyEnv": "SENSENOVA_API_KEY",
      "freeRule": {
        "kind": "plan-confirm",
        "description": "Free only inside the SenseNova Token Plan public beta, which the API cannot report: nothing is listed or probed until the user confirms the plan. Models whose catalogue price is not the string \"0\" are removed.",
        "option": "plan",
        "value": "token-plan"
      },
      "catalogFields": {
        "id": "id",
        "pricing": "pricing",
        "contextLength": ["context_length", "context_window"],
        "maxTokens": ["max_tokens", "max_completion_tokens"],
        "supportedFeatures": "supported_features",
        "businesses": "businesses"
      },
      "capabilities": {
        "tools": { "where": "supported_features", "contains": "function" },
        "vision": { "where": "supported_features", "contains": "image" },
        "reasoning": { "where": "supported_features", "contains": "reasoning" },
        "source": "catalog"
      },
      "probe": { "path": "/chat/completions", "maxTokensParam": "max_tokens", "defaultMaxTokens": 16, "prompt": "Reply with OK." },
      "errorMap": {
        "preStream": [
          { "status": [401, 402], "kind": "account" },
          { "status": [403], "kind": "model" },
          { "status": [408, 429], "kind": "transient" },
          { "statusMin": 500, "kind": "transient" }
        ],
        "default": "model"
      },
      "rateLimitHeaders": {
        "retryAfter": "retry-after",
        "reset": "x-ratelimit-reset",
        "resetFormat": "epoch-or-relative",
        "remaining": "x-ratelimit-remaining"
      },
      "keyPatterns": [{ "prefix": "sk-", "regex": "\\bsk-[A-Za-z0-9]{32}\\b" }],
      "docs": [
        { "url": "https://platform.sensenova.cn/", "checked": "2026-10-27" },
        { "url": "https://token.sensenova.cn/v1/models", "checked": "2026-10-27" }
      ]
    },
    "bailian": {
      "displayName": "阿里云百炼 (Bailian)",
      "tier": 1,
      "authKind": "api_key",
      "baseURL": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "modelsPath": "/models",
      "modelsNeedKey": true,
      "apiKeyEnv": "DASHSCOPE_API_KEY",
      "freeRule": {
        "kind": "allowlist+guard",
        "description": "Free only on the user's new-user allowance, which the API cannot report per call: nothing is listed or probed until the user confirms free_quota_guard=confirmed (\u514d\u8d39\u989d\u5ea6\u7528\u5b8c\u5373\u505c) and supplies a model allowlist. Per-model allowances are manual and unverified. Beijing region only.",
        "guardOption": "free_quota_guard",
        "guardValue": "confirmed",
        "modelsOption": "models"
      },
      "catalogFields": {
        "id": "id",
        "contextLength": ["context_length", "context_window"],
        "maxTokens": ["max_tokens", "max_completion_tokens"]
      },
      "capabilities": {
        "tools": null,
        "vision": null,
        "reasoning": null,
        "source": "unknown"
      },
      "probe": { "path": "/chat/completions", "maxTokensParam": "max_tokens", "defaultMaxTokens": 16, "prompt": "Reply with OK." },
      "errorMap": {
        "preStream": [
          { "status": [401], "kind": "account" },
          { "status": [403], "when": [{ "in": "code", "values": ["AllocationQuota.FreeTierOnly"] }], "kind": "quota" },
          {
            "status": [400, 403, 429],
            "when": [
              {
                "in": "code",
                "values": ["ModelUnavailable", "ModelBusy", "ServiceUnavailable", "Throttling.AllocationQuota"]
              }
            ],
            "kind": "capacity"
          },
          { "status": [403], "kind": "model" },
          { "status": [429], "kind": "transient" },
          { "status": [408], "kind": "transient" },
          { "statusMin": 500, "kind": "transient" }
        ],
        "default": "model"
      },
      "rateLimitHeaders": {
        "retryAfter": "retry-after",
        "reset": "x-ratelimit-reset",
        "resetFormat": "epoch-or-relative",
        "remaining": "x-ratelimit-remaining"
      },
      "keyPatterns": [
        { "prefix": "sk-ws-", "regex": "\\bsk-(?:ws|sp)-[A-Za-z0-9._-]{20,}" },
        { "prefix": "sk-", "regex": "\\bsk-[A-Fa-f0-9]{32}\\b" }
      ],
      "docs": [
        { "url": "https://help.aliyun.com/zh/model-studio/compatibility-of-openai-with-dashscope", "checked": "2026-10-29" },
        { "url": "https://help.aliyun.com/zh/model-studio/error-code", "checked": "2026-10-29" },
        { "url": "https://help.aliyun.com/zh/model-studio/new-free-quota", "checked": "2026-10-29" }
      ]
    }
  }
}
