{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ndwlbj/freemodel-sync/spec/state.schema.json",
  "title": "dsh-freemodel state file ($DSH_HOME/freemodel/state.json)",
  "description": "Catalogue cache, probe results and daily probe counters of the dsh plugin. Never holds a key; error texts are redacted. Written with mode 0600.",
  "type": "object",
  "required": ["schemaVersion", "plugin", "updatedAt", "channels", "manual"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "plugin": { "const": "dsh-freemodel" },
    "updatedAt": { "type": "string", "description": "ISO 8601 time of the last write" },
    "manual": {
      "type": "object",
      "description": "Tier-2 manual-probe results. Only provider/model/status facts; never an error text or a key.",
      "required": ["probes"],
      "additionalProperties": false,
      "properties": {
        "probes": {
          "type": "object",
          "description": "Latest manual probe per \"<dshProvider>|<model>\".",
          "additionalProperties": { "$ref": "#/$defs/manualProbe" }
        }
      }
    },
    "channels": {
      "type": "object",
      "required": ["openrouter", "groq", "sensenova", "bailian"],
      "additionalProperties": false,
      "properties": {
        "openrouter": { "$ref": "#/$defs/channel" },
        "groq": { "$ref": "#/$defs/channel" },
        "sensenova": { "$ref": "#/$defs/channel" },
        "bailian": { "$ref": "#/$defs/channel" }
      }
    }
  },
  "$defs": {
    "manualProbe": {
      "type": "object",
      "description": "One manual (tier-2) probe result. Deliberately only these six fields: no error text, no key.",
      "required": ["provider", "model", "ok", "failure_kind", "error_code", "tested_at"],
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string", "minLength": 1, "description": "dsh route id that was probed" },
        "model": { "type": "string", "minLength": 1 },
        "ok": { "type": "boolean" },
        "failure_kind": { "enum": [null, "model", "transient", "account", "capacity", "quota"] },
        "error_code": { "type": ["string", "null"], "description": "Provider/dsh code such as 11140; never the error text" },
        "tested_at": { "type": "number", "description": "Unix seconds" }
      }
    },
    "nullableNumber": { "type": ["number", "null"] },
    "nullableString": { "type": ["string", "null"] },
    "channel": {
      "type": "object",
      "required": ["catalog", "results", "daily", "blockedUntil", "lastRound"],
      "additionalProperties": false,
      "properties": {
        "catalog": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["fetchedAt", "models", "error", "errorAt"],
              "additionalProperties": false,
              "properties": {
                "fetchedAt": { "type": "number", "description": "Unix seconds of the last successful read (0: never)" },
                "models": { "type": "array", "items": { "$ref": "#/$defs/model" } },
                "error": { "$ref": "#/$defs/nullableString", "description": "Redacted error of the last failed read" },
                "errorAt": { "$ref": "#/$defs/nullableNumber" }
              }
            }
          ]
        },
        "results": {
          "type": "object",
          "description": "Latest probe result per model key (\"<provider>|<model id>\"); account/quota failures are never stored",
          "additionalProperties": { "$ref": "#/$defs/result" }
        },
        "daily": {
          "type": "object",
          "required": ["date", "count"],
          "additionalProperties": false,
          "properties": {
            "date": { "type": "string", "description": "UTC day (YYYY-MM-DD), or empty before the first probe" },
            "count": { "type": "integer", "minimum": 0, "description": "Probes sent that day" }
          }
        },
        "blockedUntil": { "$ref": "#/$defs/nullableNumber", "description": "Unix seconds; no probes before" },
        "lastRound": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["at", "probes", "stopReason"],
              "additionalProperties": false,
              "properties": {
                "at": { "type": "number" },
                "probes": { "type": "integer", "minimum": 0 },
                "stopReason": { "$ref": "#/$defs/nullableString" }
              }
            }
          ]
        }
      }
    },
    "model": {
      "type": "object",
      "required": ["provider", "id", "name", "contextLength", "tools", "input", "maxTokens", "expirationDate", "capabilities", "quota", "tier"],
      "additionalProperties": false,
      "properties": {
        "provider": { "enum": ["openrouter", "groq", "sensenova", "bailian"] },
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "contextLength": { "type": "integer", "minimum": 0 },
        "tools": { "type": ["boolean", "null"], "description": "null: the catalogue does not say (Groq)" },
        "input": { "type": "array", "items": { "enum": ["text", "image"] } },
        "maxTokens": { "type": ["integer", "null"] },
        "expirationDate": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "capabilities": {
          "type": "object",
          "required": ["tools", "vision", "reasoning", "source"],
          "additionalProperties": false,
          "properties": {
            "tools": { "type": ["boolean", "null"] },
            "vision": { "type": ["boolean", "null"] },
            "reasoning": { "type": ["boolean", "null"] },
            "source": { "enum": ["catalog", "config", "probe", "manual", "unknown"] }
          }
        },
        "quota": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["unit", "period", "limit", "used", "remaining", "resetsAt", "expiresAt", "source", "scope"],
              "additionalProperties": false,
              "properties": {
                "unit": { "enum": ["requests", "tokens", "credits", "unknown"] },
                "period": { "enum": ["rolling_5h", "week", "day", "total", "beta", "unknown"] },
                "limit": { "type": ["number", "null"] },
                "used": { "type": ["number", "null"] },
                "remaining": { "type": ["number", "null"] },
                "resetsAt": { "type": ["string", "null"] },
                "expiresAt": { "type": ["string", "null"] },
                "probesSinceRead": { "type": "integer", "minimum": 0 },
                "source": { "enum": ["api", "headers", "manual", "none"] },
                "scope": { "enum": ["account", "model"] }
              }
            }
          ]
        },
        "tier": { "enum": [1, 2] }
      }
    },
    "result": {
      "type": "object",
      "required": ["key", "ok", "ttftMs", "totalMs", "error", "statusCode", "testedAt", "failureKind", "retryAfterS", "rateLimitRemaining"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string" },
        "ok": { "type": "boolean" },
        "ttftMs": { "$ref": "#/$defs/nullableNumber" },
        "totalMs": { "$ref": "#/$defs/nullableNumber" },
        "error": { "$ref": "#/$defs/nullableString", "description": "Redacted" },
        "statusCode": { "type": ["integer", "null"] },
        "testedAt": { "type": "number", "description": "Unix seconds" },
        "failureKind": { "enum": [null, "model", "transient", "account", "capacity", "quota"] },
        "capacityStreak": { "type": "integer", "minimum": 0, "description": "Consecutive capacity results; omitted/0 when not capacity" },
        "retryAfterS": { "$ref": "#/$defs/nullableNumber" },
        "rateLimitRemaining": { "type": ["integer", "null"] }
      }
    }
  }
}
